#
# Caching rules for Nashr Foundation Website on GitHub Pages
# Optimized for maximum performance and longer cache lifetimes
#

# HTML files - cache for 1 hour to allow quick updates
/*.html
  Cache-Control: public, max-age=3600, s-maxage=3600

# CSS files - cache for 1 year with immutable flag
/*.css
  Cache-Control: public, max-age=31536000, immutable

# JavaScript files - cache for 1 year with immutable flag
/*.js
  Cache-Control: public, max-age=31536000, immutable

# Images - cache for 1 year with immutable flag
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=31536000, immutable

# Fonts - cache for 1 year with immutable flag
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable
/*.ttf
  Cache-Control: public, max-age=31536000, immutable

# Manifest and other static files
/manifest.json
  Cache-Control: public, max-age=31536000, immutable
/sitemap.xml
  Cache-Control: public, max-age=86400, s-maxage=86400
/robots.txt
  Cache-Control: public, max-age=86400, s-maxage=86400

# Security headers for all pages
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://www.gstatic.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://analytics.google.com https://firebaseinstallations.googleapis.com
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-XSS-Protection: 1; mode=block
